# Build trees and CMake
# The glob covers `build_release`, `build_debug` and any one-off sanitizer or cross-compile tree
build*/
CMakeFiles
cmake_install.cmake
CMakeCache.txt
Makefile
_deps
/lib/
/bin/
/Testing/

# Per-developer preset overrides: toolchain paths that are true of one machine, not of the project
CMakeUserPresets.json

# C and C++
*.obj
*.lib
*.exe
*.exp
*.pdb
*.ilk

# Python
# `pip install -e .` drops the compiled extension in the repository root, so suffixes match anywhere
*.so
*.pyd
*.dylib
*.whl
*.egg-info
.eggs/
dist/
wheelhouse/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
/.venv*/
# Resolver output: a library declares ranges in `pyproject.toml` and every consumer resolves its own
uv.lock

# Rust
target/
# The same for the crate: it ships no binaries and CI never builds `--locked`
Cargo.lock

# Editors, assistants, language servers and tool caches
/compile_commands.json
.cache/
.claude/
/.vs/

# macOS
.DS_Store

# Local scratch
/.tmp/
/tmp/

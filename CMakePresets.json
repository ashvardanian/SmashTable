{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Ninja, a flat build_<preset> directory, and a compilation database. Select the compiler through a preset, CC/CXX, or CMakeUserPresets.json.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SMASHTABLE_BUILD_TEST": "ON",
        "SMASHTABLE_WERROR": "ON"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "description": "Clang is the default for its diagnostics on template-heavy code, not for speed - on this tree the two compilers trade wins.",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    { "name": "gcc", "hidden": true, "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" } },
    {
      "name": "windows",
      "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "debug",
      "inherits": ["base", "clang"],
      "description": "Warnings are errors here, which is the bar the pre-release workflow holds.",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "displayName": "Debug"
    },
    {
      "name": "check",
      "inherits": ["base", "clang"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "SMASHTABLE_WERROR": "ON" },
      "displayName": "Clang with warnings as errors"
    },
    {
      "name": "release",
      "inherits": ["base", "clang"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "displayName": "Release"
    },
    {
      "name": "asan",
      "inherits": ["base", "gcc"],
      "description": "Address and behaviour sanitizers. Built with GCC, which is what the pre-release workflow runs both sanitizer legs under.",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SMASHTABLE_BUILD_SANITIZERS": "address" }
    },
    {
      "name": "tsan",
      "inherits": ["base", "gcc"],
      "description": "The hash table's lock-free slot protocol is the only concurrent code here, and a race in it is invisible to the address sanitizer. Built with GCC, which is what the pre-release workflow runs both sanitizer legs under.",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SMASHTABLE_BUILD_SANITIZERS": "thread" }
    },
    {
      "name": "linux_i386",
      "inherits": ["base", "gcc"],
      "description": "32-bit x86 through -m32, run on the 64-bit host; the CUDA test has no 32-bit toolkit.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_CXX_FLAGS": "-m32",
        "SMASHTABLE_BUILD_CUDA": "OFF"
      }
    },
    {
      "name": "cuda",
      "inherits": ["base", "clang"],
      "description": "Compiles the scoped-atomics test for every device family; it skips at run time without a device.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CUDA_HOST_COMPILER": "clang++",
        "SMASHTABLE_BUILD_CUDA": "ON"
      },
      "displayName": "CUDA - tests"
    },
    {
      "name": "msvc2026_x64",
      "inherits": ["base", "windows"],
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "displayName": "Windows x64 - Visual Studio 2026"
    },
    {
      "name": "msvc2022_x64",
      "inherits": "msvc2026_x64",
      "displayName": "Windows x64 - Visual Studio 2022",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "msvc2022_arm64",
      "inherits": ["base", "windows"],
      "generator": "Visual Studio 17 2022",
      "architecture": "ARM64",
      "displayName": "Windows ARM64 - Visual Studio 2022"
    },
    {
      "name": "android_arm64",
      "inherits": "base",
      "displayName": "Android ARM64 through the NDK's own toolchain, compile only",
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "ANDROID_ABI": "arm64-v8a", "ANDROID_PLATFORM": "android-24" }
    },
    {
      "name": "wasm32_emscripten",
      "inherits": "base",
      "displayName": "WebAssembly through Emscripten, one thread, compile only",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "EMSCRIPTEN_SYSTEM_PROCESSOR": "wasm32" }
    },
    {
      "name": "wasm64_emscripten",
      "inherits": "base",
      "displayName": "WebAssembly through Emscripten, 64-bit with threads, compile only",
      "description": "Emscripten's toolchain reads the width off the C flags as it loads, so both languages carry them.",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EMSCRIPTEN_SYSTEM_PROCESSOR": "wasm64",
        "CMAKE_C_FLAGS": "-pthread --target=wasm64",
        "CMAKE_CXX_FLAGS": "-pthread --target=wasm64",
        "CMAKE_EXE_LINKER_FLAGS": "-pthread --target=wasm64 -sALLOW_MEMORY_GROWTH"
      }
    },
    {
      "name": "machine",
      "hidden": true,
      "inherits": ["base", "clang"],
      "description": "Tests and the CUDA test for one machine: its CPU and its one GPU code.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CUDA_HOST_COMPILER": "clang++",
        "SMASHTABLE_BUILD_CUDA": "ON"
      }
    },
    {
      "name": "xeon4_hopper",
      "inherits": "machine",
      "displayName": "Xeon 4 with Hopper - compile only",
      "cacheVariables": { "CMAKE_CXX_FLAGS": "-march=sapphirerapids", "SMASHTABLE_CUDA_ARCHITECTURES": "90a-real" }
    },
    {
      "name": "xeon6_blackwell",
      "inherits": "machine",
      "displayName": "Xeon 6 with Blackwell - compile only",
      "cacheVariables": { "CMAKE_CXX_FLAGS": "-march=graniterapids", "SMASHTABLE_CUDA_ARCHITECTURES": "100f-real" }
    },
    {
      "name": "grace_hopper",
      "inherits": "machine",
      "displayName": "Grace with Hopper - compile only",
      "cacheVariables": { "CMAKE_CXX_FLAGS": "-mcpu=neoverse-v2", "SMASHTABLE_CUDA_ARCHITECTURES": "90a-real" }
    },
    {
      "name": "vera_rubin",
      "inherits": "machine",
      "displayName": "Vera with Rubin - compile only",
      "description": "Olympus cores need Clang 22 or GCC 15, and CUDA 13.4 names no Rubin code, so it compiles 100f.",
      "cacheVariables": { "CMAKE_CXX_FLAGS": "-mcpu=olympus", "SMASHTABLE_CUDA_ARCHITECTURES": "100f-real" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "check", "configurePreset": "check" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "linux_i386", "configurePreset": "linux_i386" },
    { "name": "cuda", "configurePreset": "cuda" },
    { "name": "msvc2026_x64", "configurePreset": "msvc2026_x64", "configuration": "Release" },
    { "name": "msvc2022_x64", "configurePreset": "msvc2022_x64", "configuration": "Release" },
    { "name": "msvc2022_arm64", "configurePreset": "msvc2022_arm64", "configuration": "Release" },
    { "name": "android_arm64", "configurePreset": "android_arm64" },
    { "name": "wasm32_emscripten", "configurePreset": "wasm32_emscripten" },
    { "name": "wasm64_emscripten", "configurePreset": "wasm64_emscripten" },
    { "name": "xeon4_hopper", "configurePreset": "xeon4_hopper" },
    { "name": "xeon6_blackwell", "configurePreset": "xeon6_blackwell" },
    { "name": "grace_hopper", "configurePreset": "grace_hopper" },
    { "name": "vera_rubin", "configurePreset": "vera_rubin" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 900, "noTestsAction": "error" }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
    { "name": "linux_i386", "inherits": "base", "configurePreset": "linux_i386" },
    {
      "name": "cuda",
      "inherits": "base",
      "configurePreset": "cuda",
      "filter": { "include": { "name": "test_atomic_cuda" } }
    },
    { "name": "msvc2026_x64", "inherits": "base", "configurePreset": "msvc2026_x64", "configuration": "Release" },
    { "name": "msvc2022_x64", "inherits": "base", "configurePreset": "msvc2022_x64", "configuration": "Release" },
    { "name": "msvc2022_arm64", "inherits": "base", "configurePreset": "msvc2022_arm64", "configuration": "Release" }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    },
    {
      "name": "cuda",
      "steps": [
        { "type": "configure", "name": "cuda" },
        { "type": "build", "name": "cuda" },
        { "type": "test", "name": "cuda" }
      ]
    }
  ]
}

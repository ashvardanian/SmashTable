#pragma endregion Consistency and Transaction Tests for Sets
FIXTURE

assert_rejects "pragma mark" "uses '#pragma mark'" src/probe.hpp <<'FIXTURE'
#pragma mark - Constructors
FIXTURE

assert_rejects "orphaned docblock above a brace" "docblock with nothing to document" src/probe.hpp <<'FIXTURE'

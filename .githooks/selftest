 *  @brief A @c probe.
 */
void probe();
FIXTURE

assert_rejects "split string literal" "string-literal fragments on one line" src/probe.hpp <<'FIXTURE'
char const *probe = "the first fragment " "and the second";
FIXTURE

assert_rejects "sibling justification" "justifies a decision by another repo" src/probe.hpp <<'FIXTURE'

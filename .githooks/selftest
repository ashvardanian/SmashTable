    int member;
    /** @brief Hashes for the fixture keys. */
};
FIXTURE

assert_rejects "orphaned docblock above another docblock" "docblock with nothing to document" src/probe.hpp <<'FIXTURE'
/** @brief The older description, displaced by the one below. */
/** @brief The newer description. */
void probe();
FIXTURE

assert_accepts "file docblock above pragma once" src/probe.hpp <<'FIXTURE'
/**
 *  @brief A probe.
 *  @file src/probe.hpp
 */
#pragma once
void probe();
FIXTURE

assert_rejects "bare @param" "@param without a direction" src/probe.hpp <<'FIXTURE'
/**
 *  @brief A probe.
 *  @param key The key to probe for.
 */
void probe(int key);
FIXTURE

assert_accepts "directed @param" src/probe.hpp <<'FIXTURE'

#!/usr/bin/env bash
#
# SmashTable pre-commit: enforce the house style on staged changes before they land.
#
# Each check inspects only the ADDED lines of a staged file, so legacy code migrates on its own
# schedule while no new violation sneaks in. The dispatch loop at the bottom diffs every staged file
# exactly once and hands the added lines to each check through the `file` / `added` globals.
# Configuring the CMake build arms these hooks; see the `core.hooksPath` block in CMakeLists.txt.
#
# Bypass knowingly (you almost never should) with: git commit --no-verify

set -u
export LC_ALL=C # Byte-wise regexes, immune to the committer's locale

failed=0

# Prints the reason and the first offending lines, and marks the commit rejected. `failed` counts
# rather than latches, because `selftest` asserts that a bad fixture trips exactly one rule.
added_line_numbers() { # added_line_numbers <path>
    git diff --cached --unified=0 -- "$1" | awk '
        /^@@/ {
            split($3, range, ",")
            start = substr(range[1], 2) + 0
            count = (range[2] == "") ? 1 : range[2] + 0
            for (line = start; line < start + count; ++line) print line
        }'
}

fail() { # fail <matches> <message-line>...
    local matches=$1
    shift
    local line
    for line in "$@"; do echo "pre-commit: $line"; done
    printf '%s\n' "$matches" | head -5
    failed=$((failed + 1))
}

# Compiled byte-code, caches and build output never belong in the tree. This one is a belt to
# .gitignore's braces: a `git add -f` or a stale index entry still gets caught here.
check_generated_artifacts() {
    case "$file" in
    *.pyc | *.pyo | *__pycache__* | *.egg-info* | .pytest_cache/* | wheelhouse/* | dist/*)
        echo "pre-commit: $file is generated output and must not be committed"
        failed=$((failed + 1))
        ;;
    esac
}

# ASCII "->" arrows inside comments & docstrings - prose uses the Unicode arrow (→). Lines quoting
# C++ trailing return types inside @code blocks are the one legitimate use, so they are exempt.
#
# The arrow is the shape worth matching mechanically, not the whole rule. Prose in this project reads
# as typeset text rather than as source: ≤ ≥ ≠ ≈ × ÷ ± − for relations and arithmetic, … for an
# ellipsis, ⁰¹²³ and ₀₁₂₃ for indices and exponents, ∈ ∉ ⊆ ∪ ∩ ∅ for set talk, ∞ for a bound that has
# none, and │ ├ └ ─ for a tree a diagram would otherwise draw in pipes and dashes. A rule can only
# name the one case it can spot without arguing; the rest is the author's to reach for.
check_ascii_arrows() {
    local arrows
    arrows=$(printf '%s\n' "$added" | grep -E '((//|/\*|#|^\+[[:space:]]*\*).* -> )' | grep -v '@code' || true)
    [ -z "$arrows" ] || fail "$arrows" \
        "$file writes an arrow as '->' in a comment - prose takes the Unicode → , and the same goes for ≤ ≥ ≠ × … ∈ where prose reaches for them:"
}

# An unqualified `memcpy` reaches for the C library through a name the standard only promises inside
# `std::`. Where a raw byte copy really is the operation, the qualified spelling says so.
check_memcpy() {
    local copies
    copies=$(printf '%s\n' "$added" |
        grep -vE '^\+[[:space:]]*(\*|//|/\*)' |
        grep -E '(^|[^:[:alnum:]_])memcpy[[:space:]]*\(' || true)
    [ -z "$copies" ] || fail "$copies" \
        "$file calls unqualified memcpy - write std::memcpy for a genuine byte copy, or prefer" \
        "assignment or std::bit_cast where the types should survive:"
}

# A `bool` parameter that steers behaviour reads as `f(x, true)` at the call site, which tells the
# reader nothing. Name the states in an enum, ideally a scoped one backed by `bool`.
check_boolean_parameters() {
    local switches
    # A single-argument `explicit` constructor wraps a boolean VALUE rather than selecting behaviour.
    switches=$(printf '%s\n' "$added" |
        grep -E '\b(bool)[[:space:]]+[a-z_][a-z_0-9]*[[:space:]]*[,)]' |
        grep -vE '\b(is|has|was|can|should|contains|empty|equals)_?' |
        grep -vE 'explicit[[:space:]]+[a-z_][a-z_0-9]*\([[:space:]]*bool[[:space:]]+[a-z_][a-z_0-9]*\)' || true)
    [ -z "$switches" ] || fail "$switches" \
        "$file takes a bool parameter that selects behaviour - name the states in an enum:"
}

# The Python binding forwards what the C++ layer already does; it does not build its own containers
# or its own synchronization. An STL container appearing there is almost never about the STL - it is
# a buffer invented to work around something the store does not expose yet, and the fix belongs one
# layer down. Where the binding genuinely needs to hold a sequence, `basic_vector` is the one the
# rest of the project uses, so allocation failure is a status rather than an exception.
check_binding_owns_no_containers() {
    local invented
    invented=$(printf '%s\n' "$added" |
        grep -vE '^\+[[:space:]]*(\*|//|/\*)' |
        grep -E 'std::(vector|map|set|unordered_map|unordered_set|deque|list|pair|tuple|array|shared_mutex|mutex|condition_variable|atomic|thread|lock_guard|unique_lock)\b' || true)
    [ -z "$invented" ] || fail "$invented" \
        "$file is in the Python binding and reaches for an STL container or synchronization" \
        "primitive. The binding forwards and repackages what the C++ layer does - it invents no" \
        "logic and no locking of its own. A buffer here usually means the store is missing a" \
        "surface: ask for it in include/ instead. For a sequence the binding genuinely owns, use" \
        "basic_vector, whose failures are statuses:"
}

# Comments describe what the code is, never what it was. Git holds the history.
check_backward_references() {
    local history
    history=$(printf '%s\n' "$added" |
        grep -iE '(//|^\+[[:space:]]*\*).*\b(used to be|no longer|renamed (from|to)|moved from|was formerly|as before)\b' || true)
    [ -z "$history" ] || fail "$history" \
        "$file has a backward-looking comment - describe the present, git holds the history:"
}

# Comment banners drawn as rules. Sections are `#pragma region`, which folds in every editor.
check_banner_rules() {
    local rules
    rules=$(printf '%s\n' "$added" | grep -E '(//|^\+[[:space:]]*\*)[[:space:]]*[-=#]{4,}' || true)
    [ -z "$rules" ] || fail "$rules" \
        "$file draws a comment banner - sections are '#pragma region <Name>':"
}

# The same ban in the `#`-comment languages - Python, CMake, shell, YAML, TOML - where the C-family
# spelling above cannot reach. A whole line of rule characters is a banner however it is drawn, and
# `cmake-format` and `black` both happily preserve one, so nothing else catches it.
check_hash_banners() {
    local rules
    rules=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*#[[:space:]]*[-=#*_~+]{4,}[[:space:]]*$' || true)
    [ -z "$rules" ] || fail "$rules" \
        "$file draws a comment banner - label the section with a plain comment or '# region <Name>':"
}

# clang-format reflows the spacing around punctuation in a `#pragma region` name, so the region and
# its `endregion` drift apart and stop pairing. Words, digits and underscores survive.
check_region_names() {
    local punctuated
    punctuated=$(printf '%s\n' "$added" |
        grep -E '#pragma (region|endregion)[[:space:]]+[^[:space:]]' |
        grep -vE '#pragma (region|endregion)[[:space:]]+[A-Za-z0-9_]+([[:space:]]+[A-Za-z0-9_]+)*[[:space:]]*$' || true)
    [ -z "$punctuated" ] || fail "$punctuated" \
        "$file punctuates a '#pragma region' name - clang-format reflows around '-', '&', ':' and the" \
        "rest, so the region and its endregion drift apart and stop pairing. Use words and spaces only:"
}

# Allocation goes through an allocator everywhere in this library, so a bare `new` or `delete` is
# memory the owning container cannot account for. Placement `new (address) T(...)` constructs into
# storage an allocator already handed over and stays legal, told apart by the parenthesised address.
# An allocator's own body is where that chain ends, and says so with a trailing `// allocator
# primitive` - spelled out, so it shows up in review rather than passing silently.
check_allocating_new() {
    local allocations
    allocations=$(printf '%s\n' "$added" |
        grep -vE '^\+[[:space:]]*(\*|//|/\*)' |
        grep -vE '//[[:space:]]*allocator primitive[[:space:]]*$' |
        sed -e 's|"[^"]*"||g' -e 's|/\*.*\*/||g' -e 's|//.*$||' |
        grep -E '::operator[[:space:]]+(new|delete)|new[[:space:]]*\([[:space:]]*std::nothrow|new[[:space:]]+[A-Za-z_]|(^|[^_[:alnum:]])delete[[:space:]]*(\[[[:space:]]*\])?[[:space:]]+[A-Za-z_]' || true)
    [ -z "$allocations" ] || fail "$allocations" \
        "$file allocates with a bare new or delete - route it through the container's allocator." \
        "Placement new into allocator-provided storage is fine; owning allocation is not:"
}

# A vtable buys dispatch over an OPEN set, and every type set here is closed and known at compile
# time, where `std::variant` plus `std::visit` lowers to a switch instead. `override` and `final`
# only ever appear alongside `virtual`, so they are the same violation.
check_virtual_dispatch() {
    local dispatch
    dispatch=$(printf '%s\n' "$added" |
        sed -e 's|/\*.*\*/||g' -e 's|"[^"]*"||g' -e 's|//.*$||' -e 's|^\+[[:space:]]*\*.*$||' -e 's|/\*.*$||' |
        grep -E '\b(virtual|override)\b|(struct|class)[[:space:]]+[A-Za-z_][A-Za-z_0-9]*[[:space:]]+final\b|\)[[:space:]]*((const|noexcept)[[:space:]]*)*final\b' || true)
    [ -z "$dispatch" ] || fail "$dispatch" \
        "$file uses runtime polymorphism - the alternatives here are a closed set, so hold them in a" \
        "std::variant and dispatch with std::visit, which costs a switch rather than a vtable:"
}

# A column of `//!<` beside the fields drifts out of alignment on every rename, and the house rule is
# all-or-none anyway, so the explanation belongs in the type's own docblock.
check_trailing_member_docs() {
    local trailing
    trailing=$(printf '%s\n' "$added" | grep -E '(//!<|///<|/\*\*<)' || true)
    [ -z "$trailing" ] || fail "$trailing" \
        "$file documents a member with a trailing marker - fold the explanation into the type's own" \
        "docblock and leave the members bare:"
}

# A docblock immediately followed by a closing brace or a `#pragma` documents neither. Re-derived
# from its own diff rather than the shared `added`, so two distant hunks are never read as adjacent.
check_orphan_docblocks() {
    local orphans
    orphans=$(git diff --cached -U0 -- "$file" | awk '
        /^@@/ { previous = ""; carries_file = 0; next }
        /^\+/ {
            current = substr($0, 2)
            sub(/^[[:space:]]+/, "", current)
            # A block naming @file documents the translation unit, and belongs above `#pragma once`.
            if (current ~ /@file/) carries_file = 1
            if (previous ~ /\*\/$/ &&
                (current ~ /^\}/ || current ~ /^\/\*\*/ || (current ~ /^#pragma/ && !carries_file))) print $0
            # Cleared only past the block and its pragma, so the flag survives to the `#pragma once`.
            if (current !~ /^[\/ ]?\*/ && current !~ /^#pragma/ && current !~ /^\/\*/) carries_file = 0
            if (current != "") previous = current
            next
        }
        { previous = ""; carries_file = 0 }
    ' || true)
    [ -z "$orphans" ] || fail "$orphans" \
        "$file leaves a docblock with nothing to document - it sits directly above a closing brace, a" \
        "#pragma, or a second docblock, so Doxygen binds it to the wrong symbol or drops it entirely:"
}

# `#pragma mark` is the older spelling and folds in fewer editors.
check_pragma_mark() {
    local marks
    marks=$(printf '%s\n' "$added" | grep -E '#pragma mark' || true)
    [ -z "$marks" ] || fail "$marks" \
        "$file uses '#pragma mark' - the current spelling is '#pragma region <Name>':"
}

# A bare `@param` leaves the reader guessing whether the callee writes through it.
check_param_directions() {
    local bare
    bare=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*\*[[:space:]]*@param[[:space:]]+[a-z]' || true)
    [ -z "$bare" ] || fail "$bare" \
        "$file has an @param without a direction - write @param[in], @param[out] or @param[inout]:"
}

# `@section Title` makes Doxygen eat the first word as the anchor label.
check_section_anchors() {
    local bare
    bare=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*\*[[:space:]]*@section[[:space:]]+[A-Z]' || true)
    [ -z "$bare" ] || fail "$bare" \
        "$file has an @section without an anchor - write '@section <anchor> <Title>':"
}

# An @section heading is a heading only with air around it, so the comment lines above and below must
# be empty. Spacing is context rather than a line, so this reads the whole staged file and reports only
# the headings the commit itself added - an unchanged blank line between two changed ones is invisible
# to a check that sees the diff alone.
check_section_spacing() {
    git show ":$file" | grep -q '@section' || return 0
    local cramped
    cramped=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i)
                if (lines[i] ~ /@section/ && (i in added)) {
                    if (lines[i - 1] !~ /^[[:space:]]*\*[[:space:]]*$/) printf "line %d: no empty comment line above the @section\n", i
                    if (lines[i + 1] !~ /^[[:space:]]*\*[[:space:]]*$/) printf "line %d: no empty comment line below the @section\n", i
                }
        }' <(printf '%s\n' "$added_lines") <(git show ":$file"))
    [ -z "$cramped" ] || fail "$cramped" \
        "$file crams an @section against its neighbors - keep one empty comment line" \
        "            above and below every @section heading:"
}

# Markdown emphasis prints literally through Doxygen. One or two tokens take @b instead.
check_markdown_doxygen() {
    local emphasis
    emphasis=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(\*|/\*\*).*\*\*[^*]+\*\*' || true)
    [ -z "$emphasis" ] || fail "$emphasis" \
        "$file uses Markdown emphasis in a Doxygen block - it prints literally, use @b:"
}

# Backticks are for `//` implementation comments; docblocks mark code tokens with @c.
check_doxygen_backticks() {
    local ticks
    ticks=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(\*|/\*\*).*`[^`]+`' || true)
    [ -z "$ticks" ] || fail "$ticks" \
        "$file uses backticks inside a Doxygen block - mark code tokens with @c:"
}

# `_t` marks a materialized type. A concept names a requirement rather than a type, and a class
# template names a family rather than one member of it, so neither wears the suffix - the alias that
# instantiates the template is what carries it.
check_type_suffixes() {
    local concepts templates
    concepts=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*concept[[:space:]]+[A-Za-z_]+_t\b' || true)
    [ -z "$concepts" ] || fail "$concepts" \
        "$file suffixes a concept with '_t' - a concept names a requirement, not a type, so it takes no suffix:"
    templates=$(printf '%s\n' "$added" | awk '
        /^\+[[:space:]]*template[[:space:]]*</ { pending = 1; next }
        pending && /^\+[[:space:]]*(struct|class)[[:space:]]+[A-Za-z_]+_t[[:space:]:{]/ { print; pending = 0; next }
        pending && /^\+[[:space:]]*(typename|class |std::|requires|[A-Za-z_]+ [A-Za-z_]+_|>)/ { next }
        { pending = 0 }')
    [ -z "$templates" ] || fail "$templates" \
        "$file suffixes a class template with '_t' - the template stays bare and the alias that materializes it carries the suffix:"
}

# clang-format's `BreakStringLiterals` splits an overlong literal in place, and a hand-broken literal
# never leaves two fragments on one line, so same-line adjacency is the mangle's exact signature. A
# trailing `//` pins a deliberate split, as when stopping `"\x9F" "e"` from parsing as one escape.
check_mangled_literals() {
    local fragments
    fragments=$(printf '%s\n' "$added" | grep -E '"([^"\\]|\\.)*"[[:space:]]+"' | grep -v '//' || true)
    [ -z "$fragments" ] || fail "$fragments" \
        "$file leaves two string-literal fragments on one line - hand-break the literal onto" \
        "per-fragment lines, or pin a deliberate split with a trailing // naming why:"
}

# A design justified by another project's design ages into a lie the moment that project moves.
check_sibling_justification() {
    local excuses
    # Naming a sibling as a dependency, an oracle or a data source is fine, and excused first.
    excuses=$(printf '%s\n' "$added" |
        grep -E '(//|/\*|^\+[[:space:]]*\*)' |
        grep -iE 'stringzilla|numkong|usearch|forkunion|simsimd|smallfield|stringtape' |
        grep -viE '\b(ships?|provides?|supplies|computes?|generates?|depends? on|vendored|submodule|requires?|installs?|see|@see)\b' |
        grep -iE '\b(match(es|ing)?|mirrors?|mimics?|borrow(s|ed)?|follow(s|ing)?|same|like|takes|convention|idiom|shape|split|the way|sibling)\b' || true)
    [ -z "$excuses" ] || fail "$excuses" \
        "$file justifies a decision by another repo - state what this code does and why:"
}

# Abbreviated identifiers are banned in favour of whole words: lo/hi/bot must be low/high/bottom.
# Literals and comments are blanked first, because this checks IDENTIFIERS: a binding exposing
# Python's own type names has to write `str` and `bytes`, which are full names rather than short ones.
check_abbreviated_identifiers() {
    local abbreviations
    abbreviations=$(printf '%s\n' "$added" |
        sed -e 's|"[^"]*"||g' -e "s|'[^']*'||g" -e 's|//.*$||' -e 's|^\+[[:space:]]*\*.*$||' |
        grep -E '\b(lo|hi|bot|idx|tmp|cnt|ptr|buf|len|str|val|obj|elem|iter)\b' | grep -v '@' || true)
    [ -z "$abbreviations" ] || fail "$abbreviations" \
        "$file uses an abbreviated identifier - spell it out:"
}

# The formatters are the arbiter of layout, so the hook only asks whether the staged bytes already
# agree with them. Both are optional: a checkout without them installed still commits.
check_clang_format() {
    [ "$clang_format_available" = 1 ] || return 0
    git show ":$file" | clang-format --assume-filename="$file" --dry-run -Werror > /dev/null 2>&1 && return 0
    echo "pre-commit: $file is not clang-format clean - run \`clang-format -i $file\`"
    failed=$((failed + 1))
}

check_cmake_format() {
    [ "$cmake_format_available" = 1 ] || return 0
    cmake-format --check "$file" > /dev/null 2>&1 && return 0
    echo "pre-commit: $file is not cmake-format clean - run \`cmake-format -i\` with the repo profile"
    failed=$((failed + 1))
}

# The Actions UI and required checks reference jobs and steps by name.
check_workflow_names() {
    local unnamed
    unnamed=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]+- (uses|run):' || true)
    [ -z "$unnamed" ] || fail "$unnamed" \
        "$file adds a workflow step without a 'name:' - the Actions UI references it by name:"
}

# Boxed and ruled banners are not section markers here: code uses `#pragma region` / `# region`,

# highlighting in most viewers, which only recognize the command after whitespace. Reword the
# sentence so the command stands free; parentheses around a command are the usual offender.
check_doxygen_glued() {
    local glued
    glued=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(\*|//)' |
        grep -E '[^[:space:]]@(brief|section|subsection|param|tparam|returns?|ref|see|note|file|date|author|c|p|b)\b' || true)
    [ -z "$glued" ] || fail "$glued" \
        "$file glues a Doxygen command to the previous character - write \`as @c foo does\`," \
        "            never \`(@c foo)\`; a highlighter only sees a command that follows whitespace:"
}

# An `@section` line reads as a heading only when air surrounds it: the comment lines directly
# above and below must be empty (`*` alone). Spacing is context, not a line, so this reads the

# brace and an access specifier earn their blank line like anything else. Spacing is context rather than
# a line, so this reads the whole staged file and reports only the docblocks the commit itself added.
check_docblock_spacing() {
    local cramped
    cramped=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 2; i <= last; ++i)
                if (lines[i] ~ /^[[:space:]]*\/\*\*/ && (i in added) && lines[i - 1] !~ /^[[:space:]]*$/ &&
                    lines[i - 1] !~ /^[[:space:]]*(public|private|protected):[[:space:]]*$/)
                    printf "line %d: no empty line above the docblock\n", i
        }' <(printf '%s\n' "$added_lines") <(git show ":$file"))
    [ -z "$cramped" ] || fail "$cramped" \
        "$file opens a docblock against the line above - every /** takes an empty line above it," \
        "            an opening brace included. An access specifier is the exception, since" \
        "            clang-format removes a blank line there whatever this asks for:"
}

# A `@brief` separates a summary from what follows it, so a block with nothing following carries no
# tag. Block tags are the contract trio, the file header's, and the cross-references; `@c`, `@p`,
# `@b` and `@ref` are inline markup and open nothing. A blank comment line counts too - it starts a
# body paragraph. Whole staged file, since a block is context, and only the blocks this commit added.
check_lone_brief() {
    local lone
    lone=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) {
                if (lines[i] !~ /^[[:space:]]*\/\*\*/) continue
                brief = 0; section = 0; blank = 0; touched = 0
                for (j = i; j <= last; ++j) {
                    if (j in added) touched = 1
                    if (lines[j] ~ /@brief/) brief = 1
                    if (lines[j] ~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(param|tparam|return|retval|sa|see|note|warning|par|subsection|file|author|date|section|code)([^a-z]|$)/) section = 1
                    if (lines[j] ~ /^[[:space:]]*\*[[:space:]]*$/) blank = 1
                    if (lines[j] ~ /\*\//) break
                }
                if (brief && touched && !section && !blank)
                    printf "line %d: @brief with nothing to separate it from\n", i
                i = j
            }
        }' <(printf '%s\n' "$added_lines") <(git show ":$file"))
    [ -z "$lone" ] || fail "$lone" \
        "$file tags a docblock that is one unstructured paragraph - drop the @brief," \
        "            it earns its place only above a body paragraph or a tag section:"
}

# The indented summary runs at most three lines; past that the remainder is a body paragraph, which
# is unindented and sits below a blank comment line.
check_brief_length() {
    local sprawling
    sprawling=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) {
                if (lines[i] !~ /@brief/) continue
                span = 1
                for (j = i + 1; j <= last; ++j) {
                    if (lines[j] !~ /^[[:space:]]*\*[[:space:]]{5,}[^[:space:]]/) break
                    if (lines[j] ~ /^[[:space:]]*\*[[:space:]]*@(param|tparam|return|retval|sa|see|note|warning|par|subsection|file|author|date|section|code)([^a-z]|$)/) break
                    ++span
                }
                if (span > 3 && (i in added)) printf "line %d: @brief runs %d lines\n", i, span
            }
        }' <(printf '%s\n' "$added_lines") <(git show ":$file"))
    [ -z "$sprawling" ] || fail "$sprawling" \
        "$file lets a @brief summary run past three lines - keep the summary short and move" \
        "            the rest into an unindented body paragraph below a blank comment line:"
}

# A docblock's brackets say whether it is structured. With no block tag it is prose, so the text
# starts on the opener and closes on its last line; with one it earns dedicated `/**` and `*/` lines.
# A file's own header names itself before it describes itself: @file, @author, @date, @brief, in that
# order, contiguous, with any prose below them. The whole staged file, since the header is context.
check_file_header() {
    local header
    header=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) if (lines[i] ~ /^[[:space:]]*\/\*\*/) break
            if (i > last) { print "line 1: no header docblock"; exit }
            wanted = "file author date brief"; split(wanted, order, " ")
            seen = 0; blank = 0; touched = 0
            for (j = i; j <= last; ++j) {
                if (j in added) touched = 1
                if (lines[j] ~ /^[[:space:]]*\*[[:space:]]*$/) blank = 1
                if (match(lines[j], /@(file|author|date|brief)/)) {
                    tag = substr(lines[j], RSTART + 1, RLENGTH - 1)
                    ++seen
                    if (seen <= 4 && tag != order[seen])
                        printf "line %d: @%s where @%s belongs\n", j, tag, order[seen]
                    if (blank) printf "line %d: @%s sits below a blank line, outside the tag block\n", j, tag
                }
                if (lines[j] ~ /\*\//) break
            }
            if (touched && seen < 4) printf "line %d: the header names only %d of @file, @author, @date, @brief\n", i, seen
        }' <(printf '%s\n' "$added_lines") <(git show ":$file"))
    [ -z "$header" ] || fail "$header" \
        "$file misorders its file header - name the file, then the author, the date, and the summary," \
        "            contiguously, with any prose below them:"
}

check_docblock_brackets() {
    local shape
    shape=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i) {
                if (lines[i] !~ /^[[:space:]]*\/\*\*/) continue
                tagged = 0; touched = 0; single = (lines[i] ~ /\*\//)
                for (j = i; j <= last; ++j) {
                    if (j in added) touched = 1
                    if (lines[j] ~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(brief|param|tparam|return|retval|sa|see|note|warning|par|subsection|file|author|date|section|code)([^a-z]|$)/) tagged = 1
                    if (lines[j] ~ /\*\//) break
                }
                bare_open = (lines[i] ~ /^[[:space:]]*\/\*\*[[:space:]]*$/)
                bare_close = (lines[j] ~ /^[[:space:]]*\*\/[[:space:]]*$/)
                expanded = (bare_open || bare_close)
                if (touched && !single) {
                    if (tagged && !expanded) printf "line %d: tagged docblock without its own /** and */ lines\n", i
                    if (!tagged && expanded) printf "line %d: untagged docblock spending lines on bare /** and */\n", i
                }
                i = j
            }
        }' <(printf '%s\n' "$added_lines") <(git show ":$file"))
    [ -z "$shape" ] || fail "$shape" \
        "$file mismatches a docblock's brackets to its content - prose opens on the /** and closes" \
        "            on its last line, a tagged block takes dedicated /** and */ lines:"
}

# Member documentation is Doxygen: a bare `//` line directly above a declaration (a member or a type)
# is the banned doc style - those entities get `/** @brief ... */`. The same `Type name = ...;` shape
# inside a function body is a local variable and its `//` note is a legal implementation note, and
# this library is header-only so headers carry both - so the staged file is read whole and the brace
# stack says which scope each declaration sits in, with only the added pairings reported.
check_bare_member_docs() {
    local member_docs
    member_docs=$(awk '
        NR == FNR { added[$1 + 0]; next }
        {
            line = $0
            # Block comments are stripped first, so a brace inside a docblock never moves the stack.
            if (in_comment) { if (match(line, /\*\//)) { line = substr(line, RSTART + 2); in_comment = 0 } else next }
            gsub(/\/\*([^*]|\*[^\/])*\*\//, " ", line)
            if (match(line, /\/\*/)) { line = substr(line, 1, RSTART - 1); in_comment = 1 }
            comment_at = index(line, "//")
            code = comment_at ? substr(line, 1, comment_at - 1) : line
            if (comment_at && substr(line, comment_at + 2, 1) != "/" && code ~ /^[[:space:]]*$/) { pending = $0; pending_line = FNR }
            else if (kind[depth] == "record" && pending &&
                     code ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_:<>,* ]* [A-Za-z_][A-Za-z0-9_]* *([={;]|$)/) {
                if ((pending_line in added) || (FNR in added)) printf "line %d:%s\n", pending_line, pending
                pending = ""
            }
            else if (code !~ /^[[:space:]]*$/) pending = ""
            # `statement` holds the declaration text since the last terminator, so a class whose
            # brace sits on a continuation line still opens a record scope.
            statement = statement " " code
            for (position = 1; position <= length(code); ++position) {
                character = substr(code, position, 1)
                if (character == "{") {
                    ++depth
                    kind[depth] = (kind[depth - 1] == "code") ? "code" \
                        : (statement ~ /(^|[^A-Za-z0-9_])(class|struct|union|enum)([^A-Za-z0-9_]|$)/) ? "record" \
                        : (statement ~ /(^|[^A-Za-z0-9_])namespace([^A-Za-z0-9_]|$)/) ? "namespace" : "code"
                    statement = ""
                } else if (character == "}") { if (depth > 0) delete kind[depth--]; statement = "" }
                else if (character == ";") statement = ""
            }
        }' <(printf '%s\n' "$added_lines") <(git show ":$file") || true)
    [ -z "$member_docs" ] || fail "$member_docs" \
        "$file documents a declaration with a bare \`//\` comment - docs are" \
        "            /** @brief ... */ blocks; \`//\` is for implementation notes inside bodies:"
}

if ! git rev-parse --verify HEAD > /dev/null 2>&1; then
    exit 0
fi

clang_format_available=0
cmake_format_available=0
command -v clang-format > /dev/null 2>&1 && [ -f .clang-format ] && clang_format_available=1
command -v cmake-format > /dev/null 2>&1 && [ -f .cmake-format.py ] && cmake_format_available=1

while IFS= read -r -d '' file; do
    check_generated_artifacts

    # Layout is judged on the staged bytes rather than the added lines, so a change that only
    # deletes still has to leave the file formatted.
    case "$file" in
    *.h | *.hpp | *.cpp | *.cc | *.cu | *.cuh) check_clang_format ;;
    CMakeLists.txt | *.cmake) check_cmake_format ;;
    esac

    added=$(git diff --cached -U0 -- "$file" | grep -E '^\+' | grep -v '^+++' || true)
    added_lines=$(added_line_numbers "$file")
    [ -n "$added" ] || continue
    case "$file" in
    python/*.cpp | python/*.hpp)
        check_binding_owns_no_containers
        ;;&
    *.h | *.hpp | *.cpp | *.cc | *.cu | *.cuh)
        check_ascii_arrows
        check_memcpy
        check_boolean_parameters
        check_backward_references
        check_banner_rules
        check_region_names
        check_type_suffixes
        check_pragma_mark
        check_allocating_new
        check_virtual_dispatch
        check_trailing_member_docs
        check_orphan_docblocks
        check_param_directions
        check_section_anchors
        check_section_spacing
        check_markdown_doxygen
        check_doxygen_backticks
        check_doxygen_glued
        check_docblock_spacing
        check_lone_brief
        check_brief_length
        check_file_header
        check_docblock_brackets
        check_bare_member_docs
        check_mangled_literals
        check_sibling_justification
        check_abbreviated_identifiers
        ;;
    .github/workflows/*)
        check_workflow_names
        check_hash_banners
        ;;
    # The selftest exists to carry violations - every rule it exercises needs a fixture that must be
    # rejected, and a rule that rejects the file testing it is a rule nobody can maintain.
    .githooks/selftest) ;;
    *.py | *.cmake | *.sh | *.toml | *.yml | *.yaml | CMakeLists.txt | .githooks/*)
        check_hash_banners
        ;;
    *.md)
        check_ascii_arrows
        check_backward_references
        check_sibling_justification
        ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM -z)

# JSON and YAML must satisfy the checked-in .dprint.json. Skips without dprint, installed from https://dprint.dev/install.
if command -v dprint > /dev/null 2>&1; then
    dprint_staged=()
    while IFS= read -r -d '' file; do dprint_staged+=("$file"); done \
        < <(git diff --cached --name-only -z --diff-filter=ACM -- '*.json' '*.jsonc' '*.yml' '*.yaml')
    if [ ${#dprint_staged[@]} -gt 0 ] && ! dprint check "${dprint_staged[@]}" > /dev/null 2>&1; then
        echo "pre-commit: staged JSON or YAML is not dprint clean - run: dprint fmt"
        failed=$((failed + 1))
    fi
fi

# Editor settings and extension lists stay sorted case-insensitively, so every addition has one place to go.
editor_lists=$(git diff --cached --name-only --diff-filter=ACM -- .vscode/settings.json .vscode/extensions.json .zed/settings.json)
if [ -n "$editor_lists" ]; then
    unsorted=$(printf '%s\n' "$editor_lists" | python3 -c '
import json, re, subprocess, sys
def load(path):
    text = subprocess.run(["git", "show", ":" + path], capture_output=True, text=True).stdout
    text = re.sub(r"\"(?:\\.|[^\"\\])*\"|//[^\n]*|/\*.*?\*/", lambda match: match.group(0) if match.group(0)[0] == "\"" else "", text, flags=re.S)
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", text))
for path in sys.stdin.read().split():
    data = load(path)
    lists = [list(data)] if path.endswith("settings.json") else []
    lists += [data.get(key, []) for key in ("cSpell.words", "recommendations", "unwantedRecommendations")]
    if any(list(items) != sorted(items, key=str.lower) for items in lists):
        print(path)
')
    if [ -n "$unsorted" ]; then
        echo "pre-commit: sort top-level settings keys, cSpell.words and extension recommendations case-insensitively in:"
        printf '    %s\n' $unsorted
        failed=$((failed + 1))
    fi
fi

if [ "$failed" -ne 0 ]; then
    echo ""
    echo "pre-commit: $failed check(s) failed"
    echo "Fix the staged changes and commit again. Bypass knowingly with: git commit --no-verify"
    exit 1
fi
exit 0

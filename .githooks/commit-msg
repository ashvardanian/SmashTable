#!/usr/bin/env bash
# SmashTable commit-msg: enforce the commit-message contract.
#
#   1. The subject starts with an approved verb prefix - Add / Chore / Docs / Fix / Improve /
#      Make - followed by a capitalized summary, so the history reads as a consistent changelog.
#      A refactor is an Improve; Chore covers housekeeping that rearranges rather than changes
#      behaviour; Make covers changes that touch only the build or the environment, never the
#      sources; Docs covers documentation that drifted on its own, where a doc change that
#      accompanies the code making it true belongs in that commit instead. Merge commits are
#      exempt, since Git writes their subject.
#   2. No AI-assistant attribution: no `Co-authored-by` bot trailer, no "Generated with/by
#      <assistant>", no assistant name, vendor URL, or robot emoji. Authorship is the human who
#      committed.
#
# Bypass knowingly (you almost never should) with: git commit --no-verify

set -u

message_file="$1"

# Comment lines (git's `#` scissors and helptext) never reach the final message - ignore them.
payload=$(grep -v '^#' "$message_file")
# The subject is the first non-blank line of what remains.
subject=$(printf '%s\n' "$payload" | grep -vE '^[[:space:]]*$' | head -1)

failed=0

# 1. Verb prefix. Git writes the subject itself for merges, and for the `fixup!` and `squash!` marks
# that `git commit --fixup` produces - those are transient and autosquash replaces them on rebase.
case "$subject" in
Merge*) ;;
"fixup!"* | "squash!"*) ;;
*)
    # Capitalized, unless the summary opens with a code identifier - `update()`, `snake_case`,
    # `SortedMap` - which carries its own case and must not be title-cased into something that no
    # longer names the symbol. A backtick may precede it, since a symbol is quoted as one.
    if ! printf '%s\n' "$subject" |
        grep -qE '^(Add|Chore|Docs|Fix|Improve|Make): `?([A-Z]|[a-z_][a-z0-9_]*(\(\)|_[a-z0-9_]+))'; then
        echo "commit-msg: the subject must be '<Verb>: <Capitalized summary>' with an approved verb -"
        echo "            Add Chore Docs Fix Improve Make. A leading code identifier keeps its own case."
        echo "            Got: ${subject:-<empty>}"
        failed=1
    fi
    ;;
esac

# 2. AI-assistant attribution - matched generically across assistants and vendors, not one product.
offenders=$(printf '%s\n' "$payload" | grep -inE \
    'co-authored-by:.*(\[bot\]|\bbot\b|claude|chatgpt|gpt-[0-9]|openai|copilot|gemini|\bbard\b|cursor|codeium|devin)|generated (with|by).*\b(ai|llm|claude|chatgpt|gpt|copilot|gemini|cursor|anthropic|openai)\b|\b(anthropic|openai)\.com|claude\.ai|chatgpt\.com|claude-session|🤖' || true)
if [ -n "$offenders" ]; then
    echo "commit-msg: the message carries assistant attribution - authorship is the human who committed:"
    printf '%s\n' "$offenders" | head -5
    failed=1
fi

# 3. A subject that names a change rather than gesturing at one. Two tells, both cheap to spot and
# both responsible for real titles in this history that said nothing on their own:
#
#   - The predicate compares to something else instead of stating what changed. "Unwind a refused
#     stage the way the C++ group does" needs the diff to mean anything, while "A refused stage
#     keeps the caller's pending writes" does not.
#   - A vague quantifier stands in for the subject. "One vocabulary across both layers" and
#     "Various fixes" name a mood, not a change.
#
# Deliberately narrow. Vagueness is a judgement call and a regex approximating it would reject more
# good titles than bad ones; these two shapes are mechanical enough to catch without arguing.
case "$subject" in
Merge* | "fixup!"* | "squash!"*) ;;
*)
    if printf '%s\n' "$subject" | grep -qiE '\b(the way|as|like) [^,]+ (does|did|would|says)\b'; then
        echo "commit-msg: the subject compares to something else rather than naming what changed."
        echo "            Say what the code now does, not who it now resembles."
        echo "            Got: $subject"
        failed=1
    fi
    if printf '%s\n' "$subject" | grep -qiE '^(Add|Chore|Docs|Fix|Improve|Make): (One|Some|Several|Various|Assorted|Misc|Multiple|A few|Many)\b'; then
        echo "commit-msg: the subject opens with a quantifier where the subject of the change belongs."
        echo "            Name the thing that changed, or split the commit."
        echo "            Got: $subject"
        failed=1
    fi
    ;;
esac

if [ "$failed" -ne 0 ]; then
    echo ""
    echo "Amend the message and commit again. Bypass knowingly with: git commit --no-verify"
    exit 1
fi
exit 0
